{
  "schemaVersion": 1,
  "id": "createtransmission",
  "version": "${version}",
  "name": "Create: Transfer",
  "description": "This mod adds a single block: Transmission Chain!\n\nThis block can be used to power belts in a cleaner way without using encased chain drive.",
  "authors": [
    "SerpensSolida"
  ],
  "contact": {
    "sources": "${github_repo}"
  },
  "license": "MIT",
  "icon": "assets/createtransmission/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.serpenssolida.createtransmission.fabric.CreateTransmissionFabric"
    ],
    "client": [
      "com.serpenssolida.createtransmission.fabric.CreateTransmissionFabricClient"
    ]
  },
  "mixins": [
    "createtransmission.mixins.json",
    "createtransmission-common.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "create": "*"
  }
}